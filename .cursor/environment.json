{
  "name": "Tskflow",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "bash .cursor/run-backend.sh"
    },
    {
      "name": "frontend",
      "command": "cd frontend && BROWSER=none yarn start"
    }
  ],
  "ports": [3000, 8001]
}
