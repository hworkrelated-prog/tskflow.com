{
  "name": "Tskflow",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && python3 -m uvicorn server:app --host 0.0.0.0 --port 8001 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && BROWSER=none yarn start"
    }
  ],
  "ports": [3000, 8001]
}
